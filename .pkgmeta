# Libraries are vendored in Libs/ (no externals) so a bare checkout is a
# complete, drop-in addon.
package-as: C-Spam

ignore:
    - .github
    - tests
    - scripts
    - dist
    # Repo/README artwork; the game only loads Media/icon.tga
    - Media/*.png
    - Media/*.jpg
    - Media/icon_64.tga
